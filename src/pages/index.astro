---
import SiteNav from "../components/SiteNav.astro";
import StatusBadge from "../components/StatusBadge.astro";
import { countTicketsByStatus, listTickets } from "../lib/db";
import { CATEGORY_LABELS, STATUS_LABELS } from "../lib/labels";
import { TICKET_CATEGORIES, TICKET_STATUSES, type TicketCategory, type TicketStatus } from "../lib/schema";
import "../styles.css";

const url = new URL(Astro.request.url);
const statusParam = url.searchParams.get("status");
const categoryParam = url.searchParams.get("category");
const search = url.searchParams.get("q")?.trim() ?? "";

const status = TICKET_STATUSES.includes(statusParam as TicketStatus) ? (statusParam as TicketStatus) : undefined;
const category = TICKET_CATEGORIES.includes(categoryParam as TicketCategory)
  ? (categoryParam as TicketCategory)
  : undefined;

const counts = countTicketsByStatus();
const total = counts.submitted + counts.in_progress + counts.resolved;
const tickets = listTickets({ status, category, search: search || undefined });
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ANU Fix — report and track campus facility issues</title>
  </head>
  <body>
    <SiteNav />
    <main>
      <section class="hero">
        <h1>ANU Fix</h1>
        <p>
          Spotted a broken light, a leaking tap, or a chair that's had enough? Report it and
          watch it move from <em>submitted</em> to <em>in progress</em> to <em>resolved</em>.
        </p>
        <a class="button button-primary" href="/report">Report an issue</a>
      </section>

      <section class="stats" aria-label="ticket status summary">
        <div class="stat">
          <span class="stat-count">{total}</span>
          <span class="stat-label">Total</span>
        </div>
        {
          TICKET_STATUSES.map((s) => (
            <div class="stat">
              <span class="stat-count">{counts[s]}</span>
              <span class="stat-label">{STATUS_LABELS[s]}</span>
            </div>
          ))
        }
      </section>

      <section aria-label="filter tickets">
        <form method="get" action="/" class="filters">
          <div class="field">
            <label for="q">Search</label>
            <input id="q" name="q" type="search" placeholder="Title or location" value={search} />
          </div>
          <div class="field">
            <label for="status">Status</label>
            <select id="status" name="status">
              <option value="">All statuses</option>
              {
                TICKET_STATUSES.map((s) => (
                  <option value={s} selected={s === status}>
                    {STATUS_LABELS[s]}
                  </option>
                ))
              }
            </select>
          </div>
          <div class="field">
            <label for="category">Category</label>
            <select id="category" name="category">
              <option value="">All categories</option>
              {
                TICKET_CATEGORIES.map((c) => (
                  <option value={c} selected={c === category}>
                    {CATEGORY_LABELS[c]}
                  </option>
                ))
              }
            </select>
          </div>
          <button class="button" type="submit">Apply</button>
          {(status || category || search) && <a class="button-link" href="/">Clear</a>}
        </form>
      </section>

      <section aria-label="ticket list">
        {
          tickets.length === 0 ? (
            <p class="empty-state">
              {total === 0
                ? "No tickets yet — be the first to report an issue."
                : "No tickets match those filters."}
            </p>
          ) : (
            <ul class="ticket-list">
              {tickets.map((ticket) => (
                <li class="ticket-card">
                  <a href={`/tickets/${ticket.id}`} class="ticket-title">
                    {ticket.title}
                  </a>
                  <div class="ticket-meta">
                    <span>{ticket.location}{ticket.room ? ` · Room ${ticket.room}` : ""}</span>
                    <span>{CATEGORY_LABELS[ticket.category as TicketCategory]}</span>
                    <span>{new Date(ticket.createdAt).toLocaleString("en-AU")}</span>
                  </div>
                  <StatusBadge status={ticket.status as TicketStatus} />
                </li>
              ))}
            </ul>
          )
        }
      </section>
    </main>
  </body>
</html>
